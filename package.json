{
  "name": "neutro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "12.14.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@neutro/web",
    "build": "turbo run build --filter=@neutro/web",
    "check": "turbo run check",
    "lint": "oxlint -A all -D neutro/no-comments .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "pnpm --filter @neutro/web preview",
    "preview:cloudflare": "pnpm build && pnpm --filter @neutro/web preview:cloudflare",
    "deploy": "pnpm check && pnpm build && pnpm --filter @neutro/web deploy",
    "deploy:check": "pnpm build && pnpm --filter @neutro/web deploy:check",
    "ui:add": "pnpm --filter @neutro/web exec shadcn add"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.89.0",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.9"
  }
}
