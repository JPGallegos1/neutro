{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "neutro-web",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "neutro.solutions", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true,
  },
  "vars": {
    "ANALYTICS_ENABLED": "true",
    "CONTACT_ENABLED": "true",
    "CONTACT_TO": "hola@neutro.solutions",
    "CONTACT_FROM": "no-reply@send.neutro.solutions",
    "TURNSTILE_EXPECTED_HOSTNAME": "neutro.solutions",
    "TURNSTILE_EXPECTED_ACTION": "contacto",
  },
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
}
