---
import Base from "@/layouts/base.astro";
import { site } from "@/lib/site";
---

<Base>
  <main
    id="contenido"
    class="flex min-h-screen flex-col items-center justify-center gap-4 px-6 text-center"
  >
    <p class="text-sm font-medium tracking-widest text-muted-foreground uppercase">
      {site.name}
    </p>
    <h1 lang="en" class="text-4xl font-semibold tracking-tight sm:text-6xl">
      Under construction
    </h1>
  </main>
</Base>
