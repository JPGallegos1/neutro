---
import WorkIndex from "@/components/sections/WorkIndex.astro";
import Footer from "@/components/sections/Footer.astro";
import Header from "@/components/sections/Header.astro";
import { pageMeta } from "@/data/page-meta";
import { workProjects } from "@/data/work";
import Base from "@/layouts/base.astro";

const origin = new URL(pageMeta.trabajo.canonical).origin;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${origin}/trabajo#page`,
      url: pageMeta.trabajo.canonical,
      name: pageMeta.trabajo.heading,
      description: pageMeta.trabajo.description,
      isPartOf: { "@id": `${origin}/#website` },
      about: { "@id": `${origin}/#organization` },
    },
    {
      "@type": "ItemList",
      "@id": `${origin}/trabajo#list`,
      itemListElement: workProjects.map((project, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: project.title,
        url: `${origin}${project.href}`,
      })),
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${origin}/trabajo#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Inicio",
          item: `${origin}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Trabajo",
          item: `${origin}/trabajo`,
        },
      ],
    },
  ],
};
---

<Base title={pageMeta.trabajo.title} description={pageMeta.trabajo.description}>
  <Header />
  <main id="contenido">
    <WorkIndex />
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Base>
