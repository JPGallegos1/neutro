---
import { pageMeta } from "@/data/page-meta";
import Base from "@/layouts/base.astro";
import Header from "@/components/sections/Header.astro";
import Footer from "@/components/sections/Footer.astro";
import ContactoHero from "@/components/sections/ContactoHero.astro";
import ContactoChannels from "@/components/sections/ContactoChannels.astro";
import ContactoForm from "@/components/sections/ContactoForm.astro";
---

<Base
  title={pageMeta.contacto.title}
  description={pageMeta.contacto.description}
>
  <Header />
  <main id="contenido" class="contacto-page">
    <ContactoHero />
    <ContactoChannels />
    <ContactoForm />
  </main>
  <Footer />
</Base>

<style>
  .contacto-page {
    background: #ffffff;
    color: #0a0a0a;
  }
</style>
