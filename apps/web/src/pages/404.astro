---
import Base from "@/layouts/base.astro";
---

<Base
  title="Página no encontrada — Neutro Solutions"
  description="Esta página no existe."
  noindex
>
  <main
    id="contenido"
    class="mx-auto flex min-h-screen max-w-xl flex-col items-start justify-center gap-5 px-6"
  >
    <p class="text-sm text-muted-foreground">Error 404</p>
    <h1 class="text-4xl font-semibold tracking-tight">
      Aquí todavía no hay nada.
    </h1>
    <p class="text-muted-foreground">
      La página que buscas no existe o ha cambiado de lugar.
    </p>
    <a
      href="/"
      class="rounded-md bg-primary px-4 py-2 text-sm text-primary-foreground hover:bg-primary/90"
    >
      Volver al inicio
    </a>
  </main>
</Base>
