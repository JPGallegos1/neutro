---
import Base from "@/layouts/base.astro";
import Header from "@/components/sections/Header.astro";
import Footer from "@/components/sections/Footer.astro";
import IconC from "@/components/IconC.astro";
import { ArrowRight } from "@lucide/astro";

const title = "Página no encontrada — Neutro Solutions";
const description =
  "La dirección que escribiste no existe o cambió de lugar. Podés volver al inicio o ver nuestro trabajo.";
---

<Base title={title} description={description} noindex jsonLd={false}>
  <Header />
  <main id="contenido" class="not-found">
    <div class="not-found__shell landing-shell">
      <div class="not-found__frame" aria-hidden="true"></div>
      <div class="not-found__content">
        <IconC class="not-found__icon" size={56} />
        <p class="not-found__tag" aria-hidden="true">ERROR 404</p>
        <h1 class="not-found__title">Esta página no existe</h1>
        <p class="not-found__lead">
          La dirección que escribiste no existe o cambió de lugar. Podés volver
          al inicio o ver nuestro trabajo.
        </p>
        <p class="not-found__actions">
          <a class="not-found__btn not-found__btn--primary" href="/">
            <span>Volver al inicio</span>
            <span class="not-found__btn-arrow" aria-hidden="true">
              <ArrowRight size={16} />
            </span>
          </a>
          <a class="not-found__btn not-found__btn--secondary" href="/trabajo">
            <span>Ver el trabajo</span>
            <span class="not-found__btn-arrow" aria-hidden="true">
              <ArrowRight size={16} />
            </span>
          </a>
        </p>
        <p class="not-found__contact">
          Si necesitás ayuda, escribinos a{" "}
          <a
            class="not-found__email"
            href="mailto:hola@neutro.solutions"
          >
            hola@neutro.solutions
          </a>
        </p>
      </div>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .not-found {
    background: var(--neutro-bg);
    color: var(--neutro-text);
    min-height: 764px;
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 1024px) {
    .not-found {
      min-height: 714px;
    }
  }

  .not-found__shell {
    position: relative;
    display: flex;
    flex-direction: column;
    margin-block: 16px;
    margin-inline: 24px;
    width: auto;
    max-width: none;
    height: 732px;
  }

  @media (min-width: 1024px) {
    .not-found__shell {
      margin-block: 24px;
      margin-inline: 56px;
      height: 666px;
    }
  }

  .not-found__frame {
    position: absolute;
    inset: 0;
    border: 2px solid var(--neutro-text);
    pointer-events: none;
  }

  .not-found__frame::after {
    content: "";
    position: absolute;
    inset: 9px;
    border: 1px solid var(--neutro-text-muted);
    pointer-events: none;
  }

  .not-found__content {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 40px 32px;
    text-align: center;
  }

  @media (min-width: 1024px) {
    .not-found__content {
      gap: 24px;
      padding: 56px;
    }
  }

  .not-found__tag {
    margin: 0;
    padding: 6px 10px;
    border: 1px solid var(--neutro-text-muted);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12px;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--neutro-text-muted);
  }

  .not-found__title {
    margin: 0;
    font-size: 40px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.035em;
    text-transform: lowercase;
    color: var(--neutro-text);
    overflow-wrap: anywhere;
  }

  @media (min-width: 1024px) {
    .not-found__title {
      font-size: 72px;
      overflow-wrap: normal;
      white-space: nowrap;
    }
  }

  .not-found__lead {
    margin: 0;
    max-width: 520px;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--neutro-text-muted);
  }

  @media (min-width: 1024px) {
    .not-found__lead {
      font-size: 17px;
    }
  }

  .not-found__actions {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  @media (min-width: 1024px) {
    .not-found__actions {
      flex-direction: row;
      gap: 16px;
    }
  }

  .not-found__btn {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 60px;
    padding: 0 24px;
    border-radius: 4px;
    font-family: inherit;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    color: inherit;
    transition: transform 160ms var(--ease-out, cubic-bezier(0.23, 1, 0.32, 1));
  }

  .not-found__btn:active {
    transform: scale(0.97);
  }

  @media (prefers-reduced-motion: reduce) {
    .not-found__btn {
      transition: none;
    }

    .not-found__btn:active {
      transform: none;
    }
  }

  .not-found__btn--primary {
    background: var(--neutro-text);
    color: var(--neutro-bg);
    border: 1px solid var(--neutro-text);
  }

  .not-found__btn--secondary {
    background: transparent;
    color: var(--neutro-text);
    border: 1px solid var(--neutro-text);
  }

  .not-found__btn-arrow {
    display: inline-flex;
    line-height: 0;
  }

  .not-found__contact {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    font-size: 15px;
    line-height: 1.4;
    color: var(--neutro-text-muted);
  }

  @media (min-width: 1024px) {
    .not-found__contact {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
    }
  }

  .not-found__email {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.01em;
    color: var(--neutro-text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
