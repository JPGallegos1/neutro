---
/**
 * Logo B oficial. No recolorear ni distorsionar: se elige el SVG correcto
 * (positivo / negativo) según el tema. Espacio libre ≥ ½ alto del logo.
 */
interface Props {
  /** Forzar variante oscura (footer siempre dark). */
  forceDark?: boolean;
  class?: string;
  /** Si es false, renderiza el logo sin link (p. ej. decorativo). */
  link?: boolean;
}

const { forceDark = false, class: className, link = true } = Astro.props;

/** 300×180 → 53×32 (mismo ratio 5:3 del diseño desktop). */
const width = 53;
const height = 32;
---

{link ? (
  <a
    href="/"
    class:list={["logo", forceDark && "logo--force-dark", className]}
    aria-label="Neutro Solutions"
  >
    <img
      class="logo__img logo__img--light"
      src="/images/neutro/ns-logo-b-positivo.svg"
      alt=""
      width={width}
      height={height}
      decoding="async"
    />
    <img
      class="logo__img logo__img--dark"
      src="/images/neutro/ns-logo-b-negativo.svg"
      alt=""
      width={width}
      height={height}
      decoding="async"
    />
  </a>
) : (
  <span
    class:list={["logo", forceDark && "logo--force-dark", className]}
    aria-label="Neutro Solutions"
    role="img"
  >
    <img
      class="logo__img logo__img--light"
      src="/images/neutro/ns-logo-b-positivo.svg"
      alt=""
      width={width}
      height={height}
      decoding="async"
    />
    <img
      class="logo__img logo__img--dark"
      src="/images/neutro/ns-logo-b-negativo.svg"
      alt=""
      width={width}
      height={height}
      decoding="async"
    />
  </span>
)}

<style>
  .logo {
    /* Espacio libre ≥ ½ del alto (32px → 16px) alrededor del logo */
    display: inline-flex;
    padding: 16px;
    margin: -16px;
    line-height: 0;
    text-decoration: none;
    color: inherit;
  }

  .logo__img {
    display: block;
    width: 53px;
    height: 32px;
    /* No object-fit: cover — preservar aspect ratio sin recortar */
    object-fit: contain;
  }

  .logo__img--dark {
    display: none;
  }

  :global(html.dark) .logo:not(.logo--force-dark) .logo__img--light {
    display: none;
  }

  :global(html.dark) .logo:not(.logo--force-dark) .logo__img--dark {
    display: block;
  }

  /* Footer / contextos forzados a dark: siempre negativo */
  .logo--force-dark .logo__img--light {
    display: none;
  }

  .logo--force-dark .logo__img--dark {
    display: block;
  }
</style>
