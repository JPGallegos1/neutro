---
import { contactoHeroFlags } from "@/data/contacto";
---

<section class="contacto-hero" aria-labelledby="contacto-h1">
  <h1 id="contacto-h1" class="sr-only">
    Contacto | Neutro Solutions
  </h1>
  <canvas
    id="contacto-dots"
    class="contacto-hero__canvas"
    aria-hidden="true"
    data-flags={JSON.stringify(contactoHeroFlags)}
  ></canvas>
</section>

<script>
  import {
    buildTextDots,
    contactoFlagCell,
    contactoHeroTiming,
    flagSrc,
    gridColumns,
    hasFlagPixels,
    nextDrawableFlagIndex,
    pitchForWidth,
    shouldAnimate,
    type FlagPixel,
  } from "../../lib/contacto-hero";

  type FlagMeta = { file: string; label: string };

  function initContactoHero() {
    const canvas = document.querySelector<HTMLCanvasElement>("#contacto-dots");
    if (!canvas || canvas.dataset.ready === "true") return;
    canvas.dataset.ready = "true";

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const flags = JSON.parse(canvas.dataset.flags ?? "[]") as FlagMeta[];
    const { dots, textWidth } = buildTextDots();
    const columns = gridColumns(textWidth);
    const rows = contactoFlagCell.height;
    const flagData: Record<string, FlagPixel[]> = {};
    let pitch = 12;
    let caret = true;
    let state = { flag: null as string | null, cols: 0 };

    const params = new URLSearchParams(window.location.search);
    const staticMode = params.has("static");
    const start = Number(params.get("i") || 0);
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

    function size() {
      pitch = pitchForWidth(window.innerWidth, columns);
      const dpr = window.devicePixelRatio || 1;
      canvas!.width = columns * pitch * dpr;
      canvas!.height = rows * pitch * dpr;
      canvas!.style.width = `${columns * pitch}px`;
      canvas!.style.height = `${rows * pitch}px`;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function dot(cx: number, cy: number, color: string, glow: boolean) {
      const r = pitch * 0.36;
      ctx!.beginPath();
      ctx!.arc(
        cx * pitch + pitch / 2,
        cy * pitch + pitch / 2,
        r,
        0,
        Math.PI * 2,
      );
      ctx!.fillStyle = color;
      ctx!.shadowColor = glow ? color : "transparent";
      ctx!.shadowBlur = glow ? pitch * 0.9 : 0;
      ctx!.fill();
    }

    function draw(flag: string | null, cols: number, caretOn: boolean) {
      ctx!.clearRect(0, 0, canvas!.width, canvas!.height);
      for (let y = 0; y < rows; y++) {
        for (let x0 = 0; x0 < columns; x0++) {
          dot(x0, y, "rgba(255,255,255,0.07)", false);
        }
      }
      for (const [a, b] of dots) {
        dot(a, b, "#D9D9D5", true);
      }
      const ox = textWidth + contactoFlagCell.gap;
      if (flag) {
        const pixels = flagData[flag];
        if (hasFlagPixels(pixels)) {
          for (let y = 0; y < contactoFlagCell.height; y++) {
            for (let i = 0; i < cols; i++) {
              const pixel = pixels[y * contactoFlagCell.width + i];
              if (!pixel) continue;
              const [r, g, b] = pixel;
              dot(ox + i, y, `rgb(${r},${g},${b})`, true);
            }
          }
        }
      }
      if (caretOn) {
        const cx = ox + cols + (cols ? 1 : 0);
        for (let y = 1; y < 8; y++) {
          dot(Math.min(cx, columns - 1), y, "#E8590C", true);
        }
      }
    }

    function rast(src: string): Promise<FlagPixel[]> {
      return new Promise((resolve) => {
        const image = new Image();
        image.onload = () => {
          const off = document.createElement("canvas");
          off.width = contactoFlagCell.width;
          off.height = contactoFlagCell.height;
          const offCtx = off.getContext("2d");
          if (!offCtx) {
            resolve([]);
            return;
          }
          offCtx.imageSmoothingEnabled = true;
          offCtx.drawImage(
            image,
            0,
            0,
            contactoFlagCell.width,
            contactoFlagCell.height,
          );
          const data = offCtx.getImageData(
            0,
            0,
            contactoFlagCell.width,
            contactoFlagCell.height,
          ).data;
          const out: FlagPixel[] = [];
          for (
            let i = 0;
            i < contactoFlagCell.width * contactoFlagCell.height;
            i++
          ) {
            out.push([data[i * 4]!, data[i * 4 + 1]!, data[i * 4 + 2]!]);
          }
          resolve(out);
        };
        image.onerror = () => resolve([]);
        image.src = src;
      });
    }

    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

    void (async () => {
      await Promise.all(
        flags.map(async (flag) => {
          flagData[flag.file] = await rast(flagSrc(flag.file));
        }),
      );
      size();
      window.addEventListener("resize", () => {
        size();
        draw(state.flag, state.cols, caret);
      });

      const startIndex =
        Number.isFinite(start) && start >= 0
          ? Math.floor(start) % Math.max(flags.length, 1)
          : 0;

      const flagFiles = flags.map((flag) => flag.file);

      if (!shouldAnimate(reduce.matches, staticMode)) {
        let file = flags[startIndex]?.file ?? flags[0]?.file ?? null;
        if (file && !hasFlagPixels(flagData[file])) {
          const next = nextDrawableFlagIndex(startIndex, flagFiles, flagData);
          file = flagFiles[next] ?? null;
          if (file && !hasFlagPixels(flagData[file])) file = null;
        }
        state = { flag: file, cols: contactoFlagCell.width };
        draw(state.flag, state.cols, true);
        return;
      }

      window.setInterval(() => {
        if (!shouldAnimate(reduce.matches, staticMode)) return;
        caret = !caret;
        draw(state.flag, state.cols, caret);
      }, contactoHeroTiming.blinkMs);

      let i = startIndex;
      while (true) {
        if (reduce.matches) {
          const file = flags[0]?.file ?? null;
          state = {
            flag: file && hasFlagPixels(flagData[file]) ? file : null,
            cols: contactoFlagCell.width,
          };
          draw(state.flag, state.cols, true);
          return;
        }
        const file = flags[i]?.file ?? null;
        if (!file || !hasFlagPixels(flagData[file])) {
          const next = nextDrawableFlagIndex(i, flagFiles, flagData);
          if (next === i) {
            state = { flag: null, cols: 0 };
            draw(state.flag, state.cols, true);
            await wait(contactoHeroTiming.gapMs);
            continue;
          }
          i = next;
          continue;
        }
        state.flag = file;
        for (let c = 1; c <= contactoFlagCell.width; c++) {
          state.cols = c;
          draw(state.flag, state.cols, true);
          await wait(contactoHeroTiming.colMs);
        }
        await wait(contactoHeroTiming.holdMs);
        for (let c = contactoFlagCell.width - 1; c >= 0; c--) {
          state.cols = c;
          draw(state.flag, state.cols, true);
          await wait(contactoHeroTiming.eraseMs);
        }
        await wait(contactoHeroTiming.gapMs);
        i = nextDrawableFlagIndex(i, flagFiles, flagData);
      }
    })();
  }

  initContactoHero();
  document.addEventListener("astro:page-load", initContactoHero);
</script>

<style>
  .contacto-hero {
    position: relative;
    isolation: isolate;
    background: linear-gradient(
      90deg,
      #0a0a0a 0%,
      #1f1f21 22%,
      #38383b 42%,
      #424245 50%,
      #38383b 58%,
      #1f1f21 78%,
      #0a0a0a 100%
    );
    min-height: calc(100svh - 80px);
    display: grid;
    place-items: center;
    padding: 48px 0;
    overflow-x: clip;
  }

  @media (min-width: 1024px) {
    .contacto-hero {
      min-height: calc(100svh - 96px);
    }
  }

  .contacto-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.012) 0,
      rgba(255, 255, 255, 0) 6.25%,
      rgba(0, 0, 0, 0.022) 12.5%
    );
  }

  .contacto-hero__canvas {
    position: relative;
    z-index: 1;
    display: block;
    max-width: 100%;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
