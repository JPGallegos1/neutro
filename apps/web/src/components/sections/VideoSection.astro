---
import Icon from "@/components/ui/Icon.astro";

/**
 * Assets reales pendientes (neutro.webm / neutro.mp4).
 * Poster y captions son placeholders locales.
 */
const posterSrc = "/video/neutro-poster.jpg";
const sources = [
  { src: "/video/neutro.webm", type: "video/webm" },
  { src: "/video/neutro.mp4", type: "video/mp4" },
] as const;
---

<section class="video-section" aria-label="Video de presentación">
  <div class="landing-shell landing-gutter">
    <div class="video-section__frame" data-video-root>
      <video
        class="video-section__video"
        data-video
        controls
        playsinline
        preload="metadata"
        poster={posterSrc}
        width="1328"
        height="747"
      >
        {sources.map((source) => (
          <source src={source.src} type={source.type} />
        ))}
        <track
          kind="captions"
          src="/video/neutro-captions.es.vtt"
          srclang="es"
          label="Español"
          default
        />
        Tu navegador no reproduce video HTML5.
      </video>

      <div class="video-section__overlay" data-video-overlay>
        <button
          type="button"
          class="video-section__play"
          data-video-play
          aria-label="Reproducir video"
        >
          <Icon name="play" size={28} />
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  function initVideo() {
    const root = document.querySelector<HTMLElement>("[data-video-root]");
    if (!root || root.dataset.ready === "true") return;
    root.dataset.ready = "true";

    const video = root.querySelector<HTMLVideoElement>("[data-video]");
    const overlay = root.querySelector<HTMLElement>("[data-video-overlay]");
    const playBtn = root.querySelector<HTMLButtonElement>("[data-video-play]");
    if (!video || !overlay || !playBtn) return;

    const hideOverlay = () => {
      overlay.hidden = true;
    };

    const showOverlay = () => {
      if (video.paused) overlay.hidden = false;
    };

    playBtn.addEventListener("click", async () => {
      hideOverlay();
      try {
        await video.play();
      } catch {
        showOverlay();
      }
    });

    video.addEventListener("play", hideOverlay);
    video.addEventListener("pause", showOverlay);
    video.addEventListener("ended", showOverlay);
  }

  initVideo();
  document.addEventListener("astro:page-load", initVideo);
</script>

<style>
  .video-section {
    background: var(--neutro-bg);
    padding-block: 0 64px;
  }

  @media (min-width: 1024px) {
    .video-section {
      padding-block: 0 96px;
    }
  }

  .video-section__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--neutro-border);
    background: #0a0a0a;
    overflow: hidden;
  }

  .video-section__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-section__overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: #00000026;
    pointer-events: none;
  }

  .video-section__overlay[hidden] {
    display: none;
  }

  .video-section__play {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 999px;
    border: 1px solid #ffffff66;
    background: #f6f6f4f2;
    color: #0a0a0a;
    cursor: pointer;
    transition: background-color 150ms ease;
  }

  .video-section__play:hover {
    background: color-mix(in srgb, #f6f6f4 92%, #0a0a0a 8%);
  }

  @media (min-width: 1024px) {
    .video-section__play {
      width: 68px;
      height: 68px;
    }
  }
</style>
