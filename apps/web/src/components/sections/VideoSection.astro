---
const posterSrc = "/video/neutro-poster.jpg";
const sources = [
  { src: "/video/neutro.mp4", type: "video/mp4" },
  { src: "/video/neutro.webm", type: "video/webm" },
] as const;
---

<section class="video-section">
  <div class="landing-shell landing-gutter">
    <div class="video-section__frame" data-video-root>
      <video
        class="video-section__video"
        data-video
        autoplay
        muted
        loop
        playsinline
        preload="none"
        poster={posterSrc}
        width="1280"
        height="720"
        aria-hidden="true"
      >
        {sources.map((source) => (
          <source data-src={source.src} type={source.type} />
        ))}
      </video>
    </div>
  </div>
</section>

<script>
  function prefersReducedMotion(): boolean {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  function saveDataEnabled(): boolean {
    const connection = (
      navigator as Navigator & { connection?: { saveData?: boolean } }
    ).connection;
    return connection?.saveData === true;
  }

  function afterWindowLoad(run: () => void) {
    if (document.readyState === "complete") {
      run();
      return;
    }
    window.addEventListener("load", run, { once: true });
  }

  function attachSources(video: HTMLVideoElement) {
    if (video.dataset.sourcesReady === "true") return;
    const sources =
      video.querySelectorAll<HTMLSourceElement>("source[data-src]");
    sources.forEach((source) => {
      const src = source.dataset.src;
      if (src) source.src = src;
    });
    video.load();
    video.dataset.sourcesReady = "true";
  }

  function showPoster(video: HTMLVideoElement) {
    video.autoplay = false;
    video.removeAttribute("autoplay");
    try {
      video.pause();
    } catch (error) {
      void error;
    }
    if (video.dataset.sourcesReady !== "true") return;
    video
      .querySelectorAll<HTMLSourceElement>("source[data-src]")
      .forEach((source) => {
        source.removeAttribute("src");
      });
    video.removeAttribute("src");
    try {
      video.load();
    } catch (error) {
      void error;
    }
    delete video.dataset.sourcesReady;
  }

  function playOrPoster(video: HTMLVideoElement) {
    video.muted = true;
    video.defaultMuted = true;
    let pending: Promise<void>;
    try {
      pending = video.play();
    } catch (error) {
      void error;
      showPoster(video);
      return;
    }
    void pending.catch(() => {
      showPoster(video);
    });
  }

  function initVideo() {
    const root = document.querySelector<HTMLElement>("[data-video-root]");
    if (!root || root.dataset.ready === "true") return;
    root.dataset.ready = "true";

    const video = root.querySelector<HTMLVideoElement>("[data-video]");
    if (!video) return;

    video.muted = true;
    video.defaultMuted = true;

    const startWhenVisible = () => {
      if (prefersReducedMotion() || saveDataEnabled()) {
        showPoster(video);
        return;
      }
      afterWindowLoad(() => {
        if (prefersReducedMotion() || saveDataEnabled()) {
          showPoster(video);
          return;
        }
        attachSources(video);
        playOrPoster(video);
      });
    };

    if (prefersReducedMotion() || saveDataEnabled()) showPoster(video);

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          observer.disconnect();
          startWhenVisible();
          break;
        }
      },
      { rootMargin: "200px 0px", threshold: 0.15 },
    );
    observer.observe(root);
  }

  initVideo();
  document.addEventListener("astro:page-load", initVideo);
</script>

<style>
  .video-section {
    background: var(--neutro-bg);
    padding-block: 0 64px;
  }

  @media (min-width: 1024px) {
    .video-section {
      padding-block: 0 96px;
    }
  }

  .video-section__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--neutro-border);
    background: #0a0a0a;
    overflow: hidden;
  }

  .video-section__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
