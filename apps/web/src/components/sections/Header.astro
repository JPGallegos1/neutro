---
import Logo from "@/components/Logo.astro";
import MobileDrawer from "@/components/sections/MobileDrawer.astro";
import { Menu } from "@lucide/astro";
import { navItems } from "@/data/nav";

function publicPathname(pathname: string): string {
  let path = pathname;
  if (path.endsWith("/index.html")) {
    path = path.slice(0, -"index.html".length);
  } else if (path.endsWith(".html")) {
    path = path.slice(0, -".html".length);
  }
  if (path.length > 1) {
    path = path.replace(/\/+$/, "");
  }
  if (path === "") {
    path = "/";
  }
  return path;
}

const pathname = publicPathname(Astro.url.pathname);

function navIsCurrent(href: string): boolean {
  const path = href.split("#")[0] || "/";
  const normalized = publicPathname(path);
  if (normalized === "/") return false;
  return pathname === normalized || pathname.startsWith(`${normalized}/`);
}
---

<header class="site-header dark">
  <div class="landing-shell site-header__inner">
    <Logo forceDark />

    <nav class="site-header__nav" aria-label="Principal">
      <ul class="site-header__nav-list">
        {navItems.map((item) => (
          <li>
            <a
              class="landing-link site-header__nav-link"
              href={item.href}
              aria-current={navIsCurrent(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button
      type="button"
      class="site-header__menu"
      data-drawer-open
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="menu-drawer"
    >
      <Menu size={20} />
    </button>
  </div>
</header>

<MobileDrawer navItems={navItems} />

<style>
  .site-header {
    --neutro-bg: #0a0a0a;
    --neutro-text: #f6f6f4;
    --neutro-text-muted: #b4b4af;
    --neutro-border: #262624;
    --neutro-accent-blue: #5c78ff;
    --neutro-focus: #5c78ff;
    --landing-focus: var(--neutro-text);
    background: #0a0a0a;
    color: var(--neutro-text);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 80px;
    padding-inline: var(--landing-gutter);
    padding-block: 24px;
  }

  @media (min-width: 1024px) {
    .site-header__inner {
      min-height: 96px;
      padding-block: 0;
    }
  }

  .site-header__nav {
    display: none;
  }

  .site-header__menu {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-inline-end: -12px;
    border: 0;
    background: transparent;
    color: var(--neutro-text);
    cursor: pointer;
  }

  .site-header__menu:hover {
    background: color-mix(in srgb, var(--neutro-bg) 92%, var(--neutro-text) 8%);
    border-radius: 4px;
  }

  @media (min-width: 1024px) {
    .site-header__menu {
      display: none;
    }

    .site-header__nav {
      display: block;
      margin-inline-start: auto;
    }

    .site-header__nav-list {
      display: flex;
      gap: 35px;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .site-header__nav-link {
      font-size: 13px;
      font-weight: 400;
      color: var(--neutro-text);
      padding-block: 6px;
    }

    .site-header__nav-link[aria-current="page"] {
      border-bottom: 1.5px solid var(--neutro-accent-orange);
      text-decoration: none;
    }
  }
</style>
