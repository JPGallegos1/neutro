---
---

<section class="hero" aria-labelledby="hero-title">
  <div class="landing-shell landing-gutter hero__inner">
    <h1 id="hero-title" class="hero__title">
      <span class="hero__sr">Empezá a crear el sistema que te diferencia</span>
      <span class="hero__visual" aria-hidden="true">
        <span class="hero__visual--desktop">
          <span class="hero__line">Empezá a crear</span>
          <span class="hero__line">el sistema que</span>
          <span class="hero__line">te diferencia</span>
        </span>
        <span class="hero__visual--mobile">
          <span class="hero__line">Empezá a</span>
          <span class="hero__line">crear el</span>
          <span class="hero__line">sistema</span>
          <span class="hero__line">que te</span>
          <span class="hero__line">diferencia</span>
        </span>
      </span>
    </h1>
    <p class="hero__lead">
      Transformá tu negocio hoy con sistemas que te diferencian.
    </p>
  </div>
</section>

<style>
  .hero {
    background: var(--neutro-bg);
    color: var(--neutro-text);
    overflow-x: clip;
  }

  .hero__inner {
    display: grid;
    gap: 32px;
    padding-block: 40px 64px;
  }

  @media (min-width: 1024px) {
    .hero__inner {
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 48px;
      padding-block: 56px 96px;
    }
  }

  .hero__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero__title {
    margin: 0;
    font-size: min(61px, 15.6vw);
    font-weight: 700;
    line-height: 0.93;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }

  @media (min-width: 1024px) {
    .hero__title {
      font-size: clamp(64px, 9.6vw, 138px);
    }
  }

  .hero__visual--desktop {
    display: none;
  }

  .hero__visual--mobile {
    display: block;
  }

  @media (min-width: 1024px) {
    .hero__visual--desktop {
      display: block;
    }

    .hero__visual--mobile {
      display: none;
    }
  }

  .hero__line {
    display: block;
  }

  .hero__lead {
    margin: 0;
    max-width: 270px;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.1px;
  }

  @media (min-width: 1024px) {
    .hero__lead {
      max-width: 230px;
      font-size: 20px;
      text-align: right;
      justify-self: end;
      padding-bottom: 8px;
    }
  }
</style>
