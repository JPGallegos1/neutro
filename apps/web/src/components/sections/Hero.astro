---
const posterSrc = "/video/neutro-poster.jpg";
const sources = [
  { src: "/video/neutro.webm", type: "video/webm" },
  { src: "/video/neutro.mp4", type: "video/mp4" },
] as const;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="landing-shell landing-gutter hero__inner">
    <h1 id="hero-title" class="hero__title">
      <span class="hero__sr">Empezá a crear el sistema que te diferencia</span>
      <span class="hero__visual" aria-hidden="true">
        <span class="hero__visual--desktop">
          <span class="hero__line">Empezá a crear</span>
          <span class="hero__line">el sistema que</span>
          <span class="hero__line">te diferencia</span>
        </span>
        <span class="hero__visual--mobile">
          <span class="hero__line">Empezá a</span>
          <span class="hero__line">crear el</span>
          <span class="hero__line">sistema</span>
          <span class="hero__line">que te</span>
          <span class="hero__line">diferencia</span>
        </span>
      </span>
    </h1>
    <p class="hero__lead">
      Transformá tu negocio hoy con sistemas que te diferencian.
    </p>
    <div class="hero__media" data-video-root>
      <video
        class="hero__video"
        data-video
        autoplay
        muted
        loop
        playsinline
        preload="none"
        poster={posterSrc}
        width="1280"
        height="720"
        aria-hidden="true"
      >
        {sources.map((source) => (
          <source data-src={source.src} type={source.type} />
        ))}
      </video>
    </div>
  </div>
</section>

<script>
  function prefersReducedMotion(): boolean {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  function saveDataEnabled(): boolean {
    const connection = (
      navigator as Navigator & { connection?: { saveData?: boolean } }
    ).connection;
    return connection?.saveData === true;
  }

  function afterWindowLoad(run: () => void) {
    if (document.readyState === "complete") {
      run();
      return;
    }
    window.addEventListener("load", run, { once: true });
  }

  function attachSources(video: HTMLVideoElement) {
    if (video.dataset.sourcesReady === "true") return;
    const sources =
      video.querySelectorAll<HTMLSourceElement>("source[data-src]");
    sources.forEach((source) => {
      const src = source.dataset.src;
      if (src) source.src = src;
    });
    video.load();
    video.dataset.sourcesReady = "true";
  }

  function showPoster(video: HTMLVideoElement) {
    video.autoplay = false;
    video.removeAttribute("autoplay");
    try {
      video.pause();
    } catch (error) {
      void error;
    }
    if (video.dataset.sourcesReady !== "true") return;
    video
      .querySelectorAll<HTMLSourceElement>("source[data-src]")
      .forEach((source) => {
        source.removeAttribute("src");
      });
    video.removeAttribute("src");
    try {
      video.load();
    } catch (error) {
      void error;
    }
    delete video.dataset.sourcesReady;
  }

  function playOrPoster(video: HTMLVideoElement) {
    video.muted = true;
    video.defaultMuted = true;
    let pending: Promise<void>;
    try {
      pending = video.play();
    } catch (error) {
      void error;
      showPoster(video);
      return;
    }
    void pending.catch(() => {
      showPoster(video);
    });
  }

  function initVideo() {
    const root = document.querySelector<HTMLElement>("[data-video-root]");
    if (!root || root.dataset.ready === "true") return;
    root.dataset.ready = "true";

    const video = root.querySelector<HTMLVideoElement>("[data-video]");
    if (!video) return;

    video.muted = true;
    video.defaultMuted = true;

    const startWhenVisible = () => {
      if (prefersReducedMotion() || saveDataEnabled()) {
        showPoster(video);
        return;
      }
      afterWindowLoad(() => {
        if (prefersReducedMotion() || saveDataEnabled()) {
          showPoster(video);
          return;
        }
        attachSources(video);
        playOrPoster(video);
      });
    };

    if (prefersReducedMotion() || saveDataEnabled()) showPoster(video);

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          observer.disconnect();
          startWhenVisible();
          break;
        }
      },
      { rootMargin: "200px 0px", threshold: 0.15 },
    );
    observer.observe(root);
  }

  initVideo();
  document.addEventListener("astro:page-load", initVideo);
</script>

<style>
  .hero {
    --neutro-bg: #0a0a0a;
    --neutro-text: #f6f6f4;
    --neutro-text-muted: #b4b4af;
    --neutro-border: #262624;
    --neutro-accent-blue: #5c78ff;
    --neutro-focus: #5c78ff;
    --landing-focus: var(--neutro-focus);
    background: var(--neutro-bg);
    color: var(--neutro-text);
    overflow-x: clip;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    padding-block: 40px 64px;
  }

  @media (min-width: 1024px) {
    .hero__inner {
      gap: 40px;
      padding-block: 56px 96px;
    }
  }

  .hero__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero__title {
    margin: 0;
    max-width: none;
    font-size: min(61px, 15.6vw);
    font-weight: 700;
    line-height: 0.93;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }

  @media (min-width: 1024px) {
    .hero__title {
      font-size: clamp(64px, 9.6vw, 138px);
    }
  }

  .hero__visual--desktop {
    display: none;
  }

  .hero__visual--mobile {
    display: block;
  }

  @media (min-width: 1024px) {
    .hero__visual--desktop {
      display: block;
    }

    .hero__visual--mobile {
      display: none;
    }

    .hero__visual--desktop .hero__line {
      white-space: nowrap;
    }
  }

  .hero__line {
    display: block;
  }

  .hero__lead {
    margin: 0;
    max-width: 270px;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.1px;
  }

  @media (min-width: 1024px) {
    .hero__lead {
      max-width: 230px;
      font-size: 20px;
      text-align: right;
      justify-self: end;
    }
  }

  .hero__media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .hero__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
