---
---

<section class="hero" aria-labelledby="hero-title">
  <div class="landing-shell landing-gutter hero__inner">
    <h1 id="hero-title" class="hero__title">
      Empezá a crear el sistema que te diferencia
    </h1>
    <p class="hero__lead">
      Transformá tu negocio hoy con sistemas que te diferencian.
    </p>
  </div>
</section>

<style>
  .hero {
    background: var(--neutro-bg);
    color: var(--neutro-text);
  }

  .hero__inner {
    display: grid;
    gap: 32px;
    padding-block: 40px 64px;
  }

  @media (min-width: 1024px) {
    .hero__inner {
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 48px;
      padding-block: 56px 96px;
    }
  }

  .hero__title {
    margin: 0;
    max-width: 16ch;
    font-size: clamp(64px, 9.6vw, 138px);
    font-weight: 700;
    line-height: 0.93;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }

  .hero__lead {
    margin: 0;
    max-width: 270px;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.1px;
  }

  @media (min-width: 1024px) {
    .hero__lead {
      max-width: 230px;
      font-size: 20px;
      text-align: right;
      justify-self: end;
      padding-bottom: 8px;
    }
  }
</style>
